@article{kumar_chiral_2015,
	title = {Chiral spin liquids on the kagome lattice},
	volume = {92},
	url = {https://link.aps.org/doi/10.1103/PhysRevB.92.094433},
	doi = {10.1103/PhysRevB.92.094433},
	abstract = {We study the nearest-neighbor 𝑋⁢𝑋⁢𝑍 Heisenberg quantum antiferromagnet on the kagome lattice. Here we consider the effects of several perturbations: (a) a chirality term, (b) a Dzyaloshinski-Moriya term, and (c) a ring-exchange type term on the bowties of the kagome lattice, and inquire if they can support chiral spin liquids as ground states. The method used to study these Hamiltonians is a flux attachment transformation that maps the spins on the lattice to fermions coupled to a Chern-Simons gauge field on the kagome lattice. This transformation requires us to consistently define a Chern-Simons term on the kagome lattice. We find that the chirality term leads to a chiral spin liquid even in the absence of an uniform magnetic field, with an effective spin Hall conductance of 𝜎𝑠𝑥⁢𝑦=12 in the regime of 𝑋⁢𝑌 anisotropy. The Dzyaloshinski-Moriya term also leads a similar chiral spin liquid but only when this term is not too strong. An external magnetic field also has the possibility of giving rise to additional plateaus which also behave like chiral spin liquids in the 𝑋⁢𝑌 regime. Finally, we consider the effects of a ring-exchange term and find that, provided its coupling constant is large enough, it may trigger a phase transition into a chiral spin liquid by the spontaneous breaking of time-reversal invariance.},
	number = {9},
	urldate = {2025-10-31},
	journal = {Physical Review B},
	author = {Kumar, Krishna and Sun, Kai and Fradkin, Eduardo},
	month = sep,
	year = {2015},
	note = {Publisher: American Physical Society},
	keywords = {mean field},
	pages = {094433},
	file = {APS Snapshot:/Users/fheully/Zotero/storage/PQJSTF7K/PhysRevB.92.html:text/html;Version acceptée:/Users/fheully/Zotero/storage/22F84IU3/Kumar et al. - 2015 - Chiral spin liquids on the kagome lattice.pdf:application/pdf},
}

@article{bieri_projective_2016,
	title = {Projective symmetry group classification of chiral spin liquids},
	volume = {93},
	url = {https://link.aps.org/doi/10.1103/PhysRevB.93.094437},
	doi = {10.1103/PhysRevB.93.094437},
	abstract = {We present a general review of the projective symmetry group classification of fermionic quantum spin liquids for lattice models of spin 𝑆=1/2. We then introduce a systematic generalization of the approach for symmetric ℤ2 quantum spin liquids to the one of chiral phases (i.e., singlet states that break time reversal and lattice reflection, but conserve their product). We apply this framework to classify and discuss possible chiral spin liquids on triangular and kagome lattices. We give a detailed prescription on how to construct quadratic spinon Hamiltonians and microscopic wave functions for each representation class on these lattices. Among the chiral ℤ2 states, we study the subset of U(1) phases variationally in the antiferromagnetic 𝐽1−𝐽2−𝐽𝑑 Heisenberg model on the kagome lattice. We discuss static spin structure factors and symmetry constraints on the bulk spectra of these phases.},
	number = {9},
	urldate = {2025-10-31},
	journal = {Physical Review B},
	author = {Bieri, Samuel and Lhuillier, Claire and Messio, Laura},
	month = mar,
	year = {2016},
	note = {Publisher: American Physical Society},
	keywords = {variational},
	pages = {094437},
	file = {APS Snapshot:/Users/fheully/Zotero/storage/NJE8WLKN/PhysRevB.93.html:text/html;Version soumise:/Users/fheully/Zotero/storage/F2L24F76/Bieri et al. - 2016 - Projective symmetry group classification of chiral spin liquids.pdf:application/pdf},
}

@article{ran_projected-wave-function_2007,
	title = {Projected-{Wave}-{Function} {Study} of the {Spin}-\$1/2\$ {Heisenberg} {Model} on the {Kagom}{\textbackslash}'e {Lattice}},
	volume = {98},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.98.117205},
	doi = {10.1103/PhysRevLett.98.117205},
	abstract = {We perform a Gutzwiller projected-wave-function study for the spin-1/2 Heisenberg model on the Kagomé lattice to compare energies of several spin-liquid states. The result indicates that a U(1)-Dirac spin-liquid state has the lowest energy. Furthermore, even without variational parameters, the energy turns out to be very close to that found by exact diagonalization. We show that such a U(1)-Dirac state represents a quantum phase whose low-energy physics is governed by four flavors of two-component Dirac fermions coupled to a 𝑈⁡(1) gauge field. These results are discussed in the context of recent experiments on ZnCu3⁢(OH)6⁢Cl2.},
	number = {11},
	urldate = {2025-10-31},
	journal = {Physical Review Letters},
	author = {Ran, Ying and Hermele, Michael and Lee, Patrick A. and Wen, Xiao-Gang},
	month = mar,
