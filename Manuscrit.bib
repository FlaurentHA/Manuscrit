}

@article{de_vries_magnetic_2008,
	title = {Magnetic {Ground} {State} of an {Experimental} \${S}=1/2\$ {Kagome} {Antiferromagnet}},
	volume = {100},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.100.157205},
	doi = {10.1103/PhysRevLett.100.157205},
	abstract = {We present a detailed analysis of the heat capacity of a near-perfect 𝑆 =1/2 kagome antiferromagnet, zinc paratacamite Zn𝑥⁢Cu4−𝑥⁢(OH)6⁢Cl2, as a function of stoichiometry 𝑥 →1 and for fields of up to 9 T. We obtain the heat capacity intrinsic to the kagome layers by accounting for the weak Cu2+/Zn2+ exchange between the Cu and the Zn sites, which was measured independently for 𝑥 =1 using neutron diffraction. The evolution of the heat capacity for 𝑥 =0.8…1 is then related to the hysteresis in the magnetic susceptibility. We conclude that for 𝑥 {\textgreater}0.8 zinc paratacamite is a spin liquid without a spin gap, in which unpaired spins give rise to a macroscopically degenerate ground state manifold with increasingly glassy dynamics as 𝑥 is lowered.},
	number = {15},
	urldate = {2025-10-31},
	journal = {Physical Review Letters},
	author = {de Vries, M. A. and Kamenev, K. V. and Kockelmann, W. A. and Sanchez-Benitez, J. and Harrison, A.},
	month = apr,
	year = {2008},
	note = {Publisher: American Physical Society},
	keywords = {défauts},
	pages = {157205},
	file = {Full Text PDF:/Users/fheully/Zotero/storage/DVHGXA7G/de Vries et al. - 2008 - Magnetic Ground State of an Experimental \$S=12\$ Kagome Antiferromagnet.pdf:application/pdf},
}

@article{elstner_spin-12_1994,
	title = {Spin-1/2 {Heisenberg} antiferromagnet on the kagome{\textbackslash}ifmmode{\textbackslash}acute{\textbackslash}else{\textbackslash}textasciiacute{\textbackslash}fi\{\} lattice: {High}-temperature expansion and exact-diagonalization studies},
	volume = {50},
	shorttitle = {Spin-1/2 {Heisenberg} antiferromagnet on the kagome{\textbackslash}ifmmode{\textbackslash}acute{\textbackslash}else{\textbackslash}textasciiacute{\textbackslash}fi\{\} lattice},
	url = {https://link.aps.org/doi/10.1103/PhysRevB.50.6871},
	doi = {10.1103/PhysRevB.50.6871},
	abstract = {For the spin-1/2 Heisenberg antiferromagnet on the kagomé lattice we calculate the high-temperature series for the specific heat and the structure factor. A comparison of the series with exact-diagonalization studies shows that the specific heat has further structure at lower temperature in addition to a high-temperature peak at T≊2/3. At T=0.25 the structure factor agrees quite well with results for the ground state of a finite cluster with 36 sites. At this temperature the structure factor is less than two times its T=∞ value and depends only weakly on the wave vector q, indicating the absence of magnetic order and a correlation length of less than one lattice spacing. The uniform susceptibility has a maximum at T≊1/6 and vanishes exponentially for lower temperatures.},
	number = {10},
	urldate = {2025-10-31},
	journal = {Physical Review B},
	author = {Elstner, N. and Young, A. P.},
	month = sep,
	year = {1994},
	note = {Publisher: American Physical Society},
	keywords = {tempexp},
	pages = {6871--6876},
	file = {APS Snapshot:/Users/fheully/Zotero/storage/Y5AAR82F/PhysRevB.50.html:text/html;Full Text PDF:/Users/fheully/Zotero/storage/G7FLMCAI/Elstner et Young - 1994 - Spin-12 Heisenberg antiferromagnet on the kagomeifmmodeacuteelsetextasciiacutefi lattice Hi.pdf:application/pdf},
}

@article{bernu_effect_2020,
	title = {Effect of perturbations on the kagome \${S}={\textbackslash}frac\{1\}\{2\}\$ antiferromagnet at all temperatures},
	volume = {101},
	url = {https://link.aps.org/doi/10.1103/PhysRevB.101.140403},
	doi = {10.1103/PhysRevB.101.140403},
	abstract = {The ground state of the 𝑆=12 kagome Heisenberg antiferromagnet is now recognized as a spin liquid, but its precise nature remains unsettled, even if more and more clues point towards a gapless spin liquid. We use high-temperature series expansions (HTSEs) to extrapolate the specific heat 𝑐𝑉⁡(𝑇) and the magnetic susceptibility 𝜒⁡(𝑇) over the full temperature range, using an improved entropy method with a self-determination of the ground-state energy per site 𝑒0. Optimized algorithms give HTSE coefficients up to unprecedented orders (20 in 1/𝑇) and as exact functions of the magnetic field. Three extrapolations are presented for different low-𝑇 behaviors of 𝑐𝑉: exponential (for a gapped system), and linear or quadratic (for two different types of gapless spin liquids). We study the effects of various perturbations to the Heisenberg Hamiltonian: Ising anisotropy, Dzyaloshinskii-Moriya interactions, second- and third-neighbor interactions, and randomly distributed magnetic vacancies. We propose an experimental determination of 𝜒⁡(𝑇=0), which could be nonzero, from 𝑐𝑉 measurements under different magnetic fields.},
	number = {14},
	urldate = {2025-10-31},
	journal = {Physical Review B},
	author = {Bernu, Bernard and Pierre, Laurent and Essafi, Karim and Messio, Laura},
	month = apr,
	year = {2020},
	note = {Publisher: American Physical Society},
	keywords = {tempexp},
	pages = {140403},
	file = {APS Snapshot:/Users/fheully/Zotero/storage/GHRF7IKB/PhysRevB.101.html:text/html;Version soumise:/Users/fheully/Zotero/storage/EPNWPZRV/Bernu et al. - 2020 - Effect of perturbations on the kagome \$S=frac 1 2 \$ antiferromagnet at all temperatures.pdf:application/pdf},
}

@article{barthelemy_specific_2022,
	title = {Specific {Heat} of the {Kagome} {Antiferromagnet} {Herbertsmithite} in {High} {Magnetic} {Fields}},
	volume = {12},
	url = {https://link.aps.org/doi/10.1103/PhysRevX.12.011014},
	doi = {10.1103/PhysRevX.12.011014},
	abstract = {Measuring the specific heat of herbertsmithite single crystals in high magnetic fields (up to 34 T) allows us to isolate the low-temperature kagome contribution while shifting away extrinsic Schottky-like contributions. The kagome contribution follows an original power law 𝐶𝑝⁡(𝑇 →0) ∝𝑇𝛼 with 𝛼 ∼1.5 and is found to be field independent between 28 and 34 T for temperatures 1 ≤𝑇 ≤4 K. These are serious constraints when it comes to replication using low-temperature extrapolations of high-temperature series expansions. We manage to reproduce the experimental observations if about 10\% of the kagome sites do not contribute. Between 0 and 34 T, the computed specific heat then has a minute field dependence supporting an algebraic temperature dependence in zero field, typical of a critical spin-liquid ground state. The need for an effective dilution of the kagome planes is discussed and is likely linked to the presence of copper ions on the interplane zinc sites. At very low temperatures and moderate fields, we also report some small field-induced anomalies in the total specific heat and start to elaborate on a phase diagram.},
	number = {1},
	urldate = {2025-10-31},
	journal = {Physical Review X},
	author = {Barthélemy, Quentin and Demuer, Albin and Marcenat, Christophe and Klein, Thierry and Bernu, Bernard and Messio, Laura and Velázquez, Matias and Kermarrec, Edwin and Bert, Fabrice and Mendels, Philippe},
	month = jan,
	year = {2022},
	note = {Publisher: American Physical Society},
	keywords = {specificheat},
	pages = {011014},
	file = {APS Snapshot:/Users/fheully/Zotero/storage/3CV74X6G/PhysRevX.12.html:text/html;Full Text PDF:/Users/fheully/Zotero/storage/R5VT2EAW/Barthélemy et al. - 2022 - Specific Heat of the Kagome Antiferromagnet Herbertsmithite in High Magnetic Fields.pdf:application/pdf},
}

@article{imai_63mathrmcu_2008,
	title = {\${\textasciicircum}\{63\}{\textbackslash}mathrm\{{Cu}\}\$, \${\textasciicircum}\{35\}{\textbackslash}mathrm\{{Cl}\}\$, and \${\textasciicircum}\{1\}{\textbackslash}mathrm\{{H}\}\$ {NMR} in the \${S}={\textbackslash}frac\{1\}\{2\}\$ {Kagome} {Lattice} \$\{{\textbackslash}mathrm\{{ZnCu}\}\}\_\{3\}({\textbackslash}mathrm\{{OH}\}\{)\}\_\{6\}\{{\textbackslash}mathrm\{{Cl}\}\}\_\{2\}\$},
	volume = {100},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.100.077203},
	doi = {10.1103/PhysRevLett.100.077203},
	abstract = {ZnCu3⁢(OH)6⁢Cl2 (𝑆 =12) is a promising new candidate for an ideal Kagome Heisenberg antiferromagnet, because there is no magnetic phase transition down to ∼50 mK. We investigated its local magnetic and lattice environments with NMR techniques. We demonstrate that the intrinsic local spin susceptibility decreases toward 𝑇 =0, but that slow freezing of the lattice near ∼50 K, presumably associated with OH bonds, contributes to a large increase of local spin susceptibility and its distribution. Spin dynamics near 𝑇 =0 obey a power-law behavior in high magnetic fields.},
	number = {7},
	urldate = {2025-10-31},
	journal = {Physical Review Letters},
	author = {Imai, T. and Nytko, E. A. and Bartlett, B. M. and Shores, M. P. and Nocera, D. G.},
	month = feb,
	year = {2008},
	note = {Publisher: American Physical Society},
	keywords = {NMR},
	pages = {077203},
	file = {APS Snapshot:/Users/fheully/Zotero/storage/6NCXH23F/PhysRevLett.100.html:text/html},
}

