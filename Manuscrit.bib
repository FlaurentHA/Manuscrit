	doi = {10.1103/PhysRevLett.98.077204},
	abstract = {We report muon spin rotation measurements on the 𝑆 =1/2 (Cu2+) paratacamite Zn𝑥⁢Cu4−𝑥⁢(OH)6⁢Cl2 family. Despite a Weiss temperature of ∼−300 K, the 𝑥 =1 compound is found to have no transition to a magnetic frozen state down to 50 mK as theoretically expected for the kagomé Heisenberg antiferromagnet. We find that the limit between a dynamical and a partly frozen ground state occurs around 𝑥 =0.5. For 𝑥 =1, we discuss the relevance to a singlet picture.},
