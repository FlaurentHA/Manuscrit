	title = {Self—{Consistent} {Molecular} {Orbital} {Methods}. {XII}. {Further} {Extensions} of {Gaussian}—{Type} {Basis} {Sets} for {Use} in {Molecular} {Orbital} {Studies} of {Organic} {Molecules}},
