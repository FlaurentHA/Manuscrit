	pages = {8216},
	file = {Full Text PDF:/Users/fheully/Zotero/storage/DLNWXGJB/Burgess et al. - 2015 - Magnetic fingerprint of individual Fe4 molecular magnets under compression by a scanning tunnelling.pdf:application/pdf},
}

