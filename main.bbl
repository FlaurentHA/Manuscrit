      \field{month}{10}
      \field{note}{Publisher: American Physical Society}
      \field{number}{13}
      \field{shorttitle}{Derivation of spin {Hamiltonians} from the exact {Hamiltonian}}
      \field{title}{Derivation of spin {Hamiltonians} from the exact {Hamiltonian}: {Application} to systems with two unpaired electrons per magnetic site}
