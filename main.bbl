      \field{note}{Publisher: American Chemical Society}
      \field{number}{12}
      \field{title}{What {Are} the {Physical} {Contents} of {Hubbard} and {Heisenberg} {Hamiltonian} {Interactions} {Extracted} from {Broken} {Symmetry} {DFT} {Calculations} in {Magnetic} {Compounds}?}
